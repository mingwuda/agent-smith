[Unit]
Description=Obscura Headless Browser (CDP server for Desktop Agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/desktop-agent/deps/obscura
ExecStart=/opt/desktop-agent/deps/obscura/obscura serve -p 9222 --host 127.0.0.1 --allow-private-network --font-dir /usr/share/fonts/google-noto-cjk
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target